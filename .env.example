# ===================== ARCA =====================
# Tu CUIT (11 dígitos, sin guiones)
ARCA_CUIT=20111111112
# Rutas a tu certificado y clave
ARCA_CERT_PATH=certs/testing.crt
ARCA_KEY_PATH=certs/testing.key
# Punto de venta habilitado para Web Services
ARCA_PTO_VTA=1
# false = Homologación (testing), true = Producción
ARCA_PRODUCTION=false

# Datos del emisor (aparecen en el PDF y deciden el tipo de factura)
# MONOTRIBUTO -> Factura C | RESPONSABLE_INSCRIPTO -> Factura A o B automática | EXENTO -> Factura C
ARCA_EMISOR_CONDICION_IVA=MONOTRIBUTO
ARCA_EMISOR_RAZON_SOCIAL=Mi Empresa
ARCA_EMISOR_DOMICILIO=Av. Siempreviva 742, CABA
ARCA_EMISOR_IIBB=
# Formato AAAA-MM-DD
ARCA_EMISOR_INICIO_ACTIVIDADES=

# ===================== WhatsApp Cloud API (Meta) =====================
# Panel: developers.facebook.com -> tu app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que inventás vos; se pega igual en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret (para validar la firma de cada webhook)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
# Números autorizados a facturar, separados por coma (con código de país, sin +)
WHATSAPP_ALLOWED_NUMBERS=5491112345678
# Convierte 549XXXXXXXXXX -> 54XXXXXXXXXX al responder (quirk de números argentinos en la API)
WHATSAPP_FIX_AR_NUMBERS=true

# ===================== IA (Gemini) =====================
# Sin API key el bot usa un parser básico solo para texto (no entiende audios ni fotos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===================== Reglas del bot =====================
# Monto desde el cual ARCA exige identificar al Consumidor Final
CONSUMIDOR_FINAL_TOPE=10000000
# Concepto por defecto si no se puede inferir: 1 productos, 2 servicios, 3 ambos
BOT_CONCEPTO_DEFAULT=2
# Minutos que se guarda un borrador sin actividad
BOT_SESSION_TTL_MINUTES=15
# Consultar el padrón de ARCA (ws_sr_constancia_inscripcion) para nombre y condición IVA del CUIT
BOT_CONSULTAR_PADRON=true
# Alerta de tope de Monotributo (facturación anual de tu categoría). Vacío = sin alerta
MONOTRIBUTO_TOPE_ANUAL=
MONOTRIBUTO_CATEGORIA=

# ===================== Servidor =====================
PORT=3000

# ===================== Base de datos (MySQL) =====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=arca_facturacion

# ===================== Seguridad =====================
# 32 bytes en hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# API REST (/api/*): header X-API-Key. Vacío = la API solo responde a localhost.
API_KEY=
# Orígenes permitidos por CORS separados por coma (vacío = ninguno)
CORS_ORIGIN=
