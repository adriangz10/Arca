{
  "info": {
    "_postman_id": "arca-facturacion-api-collection",
    "name": "ARCA Facturación Electrónica API (Argentina)",
    "description": "Colección completa con TODOS los tipos de comprobantes oficiales de ARCA (CbteTipo: A, B, C, M, Notas de Crédito, Débito, Recibos y FCE MiPyMEs), Historial de Facturas, Selección por ID, PDF y QR.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "Valor de API_KEY del .env"
    }
  ],
  "item": [
    {
      "name": "1. Diagnóstico y Tablas Oficiales",
      "item": [
        {
          "name": "Consultar Estado ARCA y Ticket WSAA (12h)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status"
              ]
            }
          }
        },
        {
          "name": "Consultar Tablas Maestras Oficiales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tables"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Historial y Consultas de Facturas",
      "item": [
        {
          "name": "Listar Todas las Facturas Emitidas (Historial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vouchers?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vouchers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "tipoComprobante",
                  "value": "6",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Seleccionar Factura por ID o Número",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/1-6-1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vouchers",
                "1-6-1"
              ]
            }
          }
        },
        {
          "name": "Descargar / Ver PDF de Factura por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/1-6-1/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vouchers",
                "1-6-1",
                "pdf"
              ]
            }
          }
        },
        {
          "name": "Consultar Último Comprobante en ARCA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/last?ptoVta=1&tipo=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vouchers",
                "last"
              ],
              "query": [
                {
                  "key": "ptoVta",
                  "value": "1"
                },
                {
                  "key": "tipo",
                  "value": "6"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Emisión de Facturas (A, B, C, M)",
      "item": [
        {
          "name": "Emitir Factura B (Consumidor Final)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"importeNeto\": 100.00,\n  \"alicuotaIva\": 5,\n  \"condicionIva\": 5,\n  \"dniOCuit\": 0,\n  \"receptorRazonSocial\": \"Consumidor Final Ejemplo\",\n  \"puntoVenta\": 1,\n  \"concepto\": 1,\n  \"items\": [\n    {\n      \"descripcion\": \"Servicio de Consultoría Web\",\n      \"cantidad\": 1,\n      \"precioUnitario\": 100.00,\n      \"subtotal\": 100.00\n    }\n  ],\n  \"generarPdf\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/factura-b",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vouchers",
                "factura-b"
              ]
            }
          }
        },
        {
          "name": "Emitir Factura A (Responsable Inscripto)",
