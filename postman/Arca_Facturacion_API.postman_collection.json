              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuitReceptor\": 20111111112,\n  \"receptorRazonSocial\": \"Empresa Pagadora\",\n  \"importeNeto\": 1000.00,\n  \"alicuotasIva\": [\n    {\n      \"id\": 5,\n      \"baseImponible\": 1000.00,\n      \"importe\": 210.00\n    }\n  ],\n  \"puntoVenta\": 1,\n  \"generarPdf\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/factura-m",
